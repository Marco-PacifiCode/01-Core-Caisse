// Core Caisse — moteur de POINT DE VENTE / tenue de caisse au comptoir, multi-tenant.
// Il ORCHESTRE les autres cores : à l'encaissement il pousse une facture + un paiement à Core-Compta
// et décrémente Core-Stock. Il ne refait NI la compta (Compta) NI l'inventaire (Stock) — il gère les
// OPÉRATIONS de vente/encaissement (ticket, paiements offline, rendu monnaie, session/clôture Z).
//
// Isolation par tenantId sur chaque table + RLS PostgreSQL (voir prisma/rls.sql).
// tenantId = UUID scalaire (résolu via core_auth /api/tenant, pas de table locale).
// Argent = XPF entier (BigInt), jamais de float/centime.
//
// --- Choix de conception : montants STOCKÉS sur la vente ---
// Sale.subtotalXpf / totalXpf sont STOCKÉS (source de vérité du ticket au moment de l'encaissement),
// pas re-sommés depuis les lignes à chaque lecture — même philosophie que Core-Compta (Invoice.totalXpf)
// et Core-Stock (StockItem.qtyOnHand). Ils sont figés à la validation du ticket.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// État d'une session de caisse (journée / poste).
enum SessionStatus {
  OPEN
  CLOSED
}

// Cycle de vie d'un ticket de vente.
enum SaleStatus {
  DRAFT // en cours de composition (lignes ajoutées, pas encore encaissé)
  PAID // encaissé + poussé à Compta/Stock (invoiceId rempli)
  VOID // annulé avant encaissement
}

// Nature d'une ligne de ticket.
enum LineKind {
  SERVICE // prestation (ex : soin cabine) — pas de décrément stock
  PRODUCT // produit physique — décrémente Core-Stock (productId requis)
  OTHER // divers (remise forfaitaire, frais…) — pas de stock
}

// Moyen de paiement offline (pas de Core-Paiement en ligne en v1).
enum PayMethod {
  CASH
  CARD
  TRANSFER
  CHEQUE
  OTHER
}

// Session de caisse : ouverture avec fond de caisse, clôture Z (attendu vs compté, écart).
model CashSession {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  openedBy         String        @db.Uuid // staff qui a ouvert la session (UUID)
  openedByName     String? // nom lisible du staff figé à l'ouverture (affichage caisse)
  openedAt         DateTime      @default(now())
  openingFloatXpf  BigInt        @default(0) // fond de caisse initial (espèces), XPF entier
  closedAt         DateTime?
  closedBy         String?       @db.Uuid
  closedByName     String? // nom lisible du staff figé à la clôture (affichage caisse)
  closingCountedXpf BigInt? // espèces réellement comptées à la clôture (saisie caissier)
  expectedXpf      BigInt? // attendu = fond + encaissements ESPÈCES rattachés (figé à la clôture)
  varianceXpf      BigInt? // écart = compté - attendu (négatif = manquant, positif = excédent)
  note             String?
  status           SessionStatus @default(OPEN)
  // Poste (caisse physique) qui tient cette session. NULL = marchand
  // mono-caisse : c'est le cas des trois marchands d'origine, et leur
  // comportement est inchangé.
  // Ajouté le 2026-08-15 pour la Rôtisserie de Pouembout, qui a DEUX comptoirs
  // hors ligne. `String` et non une relation : l'identifiant est tiré par la
  // tablette elle-même, sans réseau, donc le serveur ne le connaît pas d'avance.
  //
  // ⚠️ L'unicité « une seule session OUVERTE par poste » est garantie en BASE
  // par l'index partiel `uniq_session_open_par_poste`
  // (prisma/manual/2026-08-15_postes_de_caisse.sql) — Prisma ne sait pas
  // modéliser un index partiel, il n'apparaît donc pas ici.
  posteId          String?

  // Origine externe d'une session IMPORTÉE (2026-08-23, Rôtisserie de
  // Pouembout) : une clôture Z faite hors ligne sur une tablette, remontée
  // telle quelle via lib/import-cloture.ts — jamais via openSession/
  // closeSession, qui restent le chemin vivant, inchangé, des 3 autres
  // marchands. NULL = session du chemin vivant (comportement d'origine).
  //
  // ⚠️ L'unicité « un même (tenantId, sourceType, sourceId) ne crée qu'une
  // session » est garantie en BASE par l'index unique partiel
  // `uniq_session_external_source` (prisma/manual/2026-08-23_import_cloture_z.sql)
  // — Prisma ne modélise pas un index partiel, il n'apparaît donc pas ici.
  sourceType       String?
  sourceId         String?

  sales     Sale[]
  movements CashMovement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([tenantId, posteId])
}

// Ticket de vente (panier au comptoir).
model Sale {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  sessionId   String?      @db.Uuid // session de caisse de rattachement (null = hors session)
  session     CashSession? @relation(fields: [sessionId], references: [id])
  status      SaleStatus   @default(DRAFT)
  cashierId   String?      @db.Uuid // staff qui encaisse
  clientName  String? // nom client optionnel (repris sur la facture)
  subtotalXpf BigInt       @default(0) // somme des lignes (= total en v1, pas de remise globale séparée)
  totalXpf    BigInt       @default(0) // total à payer, XPF entier
  // Lien source externe optionnel (ex : RDV honoré) — souple, sans FK.
  sourceType  String?
  sourceId    String?
  // Poste ayant émis la vente. NULL = marchand mono-caisse (comportement
  // d'origine, inchangé). Ajouté le 2026-08-15 : voir CashSession.posteId.
  posteId     String?
  invoiceId   String? // rempli après le push facture Compta (idempotence de bout en bout)
  invoiceNumber String? // numéro lisible renvoyé par Compta (pour le reçu)
  paidAt      DateTime?
  // ── État de synchro post-encaissement (chantier fiabilité 2026-07, cf. lib/sync.ts) ──
  // Vente « à réparer » ⇔ status=PAID ET (comptaSyncedAt IS NULL OU stockSyncedAt IS NULL).
  // Index PARTIEL de balayage `idx_sale_sync_pending` dans prisma/rls.sql (non modélisable ici).
  comptaSyncedAt DateTime? // facture créée + paiements soldés côté Core-Compta
  stockSyncedAt  DateTime? // décréments SALE passés côté Core-Stock (posé même sans ligne PRODUCT)
  syncError      String? // dernière erreur de synchro ("core:op kind status detail")
  syncAttempts   Int       @default(0) // nombre de tentatives de synchro
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines    SaleLine[]
  payments SalePayment[]

  // Idempotence source externe : une vente issue d'un même (sourceType, sourceId) n'est créée qu'une fois.
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
  @@index([tenantId, sessionId])
  @@index([tenantId, createdAt])
  @@index([tenantId, posteId])
}

// Ligne de ticket.
model SaleLine {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  saleId    String   @db.Uuid
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind      LineKind
  label     String
  productId String?  @db.Uuid // requis si kind=PRODUCT → cible du décrément Core-Stock
  qty       Int      @default(1) // quantité (entier — un article = 1 unité stock)
  unitXpf   BigInt   @default(0) // prix unitaire XPF entier
  lineXpf   BigInt   @default(0) // = unitXpf * qty (stocké, figé à la validation)
  // Taux de TGC PROPRE à cette ligne, en ppm (2026-08-23) — traverse jusqu'à
  // Core-Compta (lignes de facture) sans être recalculé ici. Optionnel : absent
  // = comportement inchangé (Compta ne reçoit pas le champ, PAS 0 — 0
  // signifierait « hors champ TGC », ce qui n'est pas la même chose que « non
  // renseigné »).
  tgcRatePpm Int?
  createdAt DateTime @default(now())

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
}

// Paiement encaissé (offline). Paiement MIXTE = plusieurs SalePayment pour un même Sale.
model SalePayment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  saleId      String    @db.Uuid
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PayMethod
  amountXpf   BigInt // montant imputé à la vente (ce qui solde la facture)
  tenderedXpf BigInt? // montant remis par le client (espèces) — pour le rendu monnaie
  // Référence idempotente vers le Payment côté Compta (POST /api/settle paymentRef).
  // Déterministe : "caisse:<saleId>:<index>" → rejouer /api/settle ne double pas le paiement.
  settleRef   String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, saleId])
}

// ── MOUVEMENT DE TIROIR ────────────────────────────────────────────────────────────────────
// Nature d'un mouvement d'espèces qui n'est PAS une vente.
//
// POURQUOI CE MODÈLE EXISTE (chantier « écart de caisse », décision Marco 2026-08-05)
// Jusqu'ici le Z ne connaissait qu'une seule source d'espèces : les règlements CASH des ventes
// PAID de la session. Quand un salon REMBOURSAIT un avoir en espèces, l'argent sortait du tiroir
// sans qu'aucune ligne ne l'explique : le Z du soir affichait un manquant anonyme, indiscernable
// d'une erreur de caisse.
//
// LE CHOIX, ET CE QU'IL ÉCARTE : on aurait pu écrire une « vente négative » (zéro migration) — le
// Z se serait corrigé tout seul. Écarté, parce que cela ferait BAISSER LE CHIFFRE D'AFFAIRES
// (totalSalesXpf somme les Sale.totalXpf) et parce qu'une Sale PAID non synchronisée tomberait
// dans idx_sale_sync_pending, où le cron de reprise lui CRÉERAIT une facture.
// Un mouvement de tiroir est une opération de TRÉSORERIE, pas une vente : il corrige l'attendu
// sans toucher au CA. Ce sont deux grandeurs différentes, elles restent séparées.
enum CashMovementKind {
  REFUND // remboursement d'un avoir : l'argent sort du tiroir pour la cliente
  CASH_OUT // prélèvement (dépôt en banque, achat, appoint)
  CASH_IN // apport de fond en cours de journée
}

// Mouvement d'espèces rattaché à une session de caisse.
model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  // OBLIGATOIRE, et c'est le cœur du dispositif : un mouvement hors session serait invisible
  // de tout Z, donc inutile. La route refuse d'écrire s'il n'y a pas de session OUVERTE — c'est
  // ce refus qui fait que le Z se ferme juste TOUT SEUL, sans discipline humaine.
  sessionId     String           @db.Uuid
  session       CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  kind          CashMovementKind
  // TOUJOURS POSITIF. Le SENS vient de `kind`, jamais du signe — le reste de ce moteur suppose
  // des montants positifs (normalizePayments écrase les ≤ 0), on ne fabrique pas d'exception.
  amountXpf     BigInt
  reason        String // obligatoire : un écart de caisse doit être justifié, sinon on l'a juste déplacé
  // Numéro de la pièce à l'origine du mouvement (ex. « AVO-2026-0001 ») quand kind = REFUND.
  // Porte l'unicité anti-double-remboursement (voir @@unique ci-dessous).
  ref           String?
  createdBy     String?          @db.Uuid // qui a ouvert le tiroir — la trace manquait partout
  createdByName String?
  createdAt     DateTime         @default(now())

  @@unique([tenantId, ref]) // un avoir ne se rembourse qu'UNE fois, garanti EN BASE et pas au clic.
  // NULLS DISTINCT (défaut PostgreSQL) : plusieurs mouvements SANS ref restent permis — c'est
  // voulu, un prélèvement ou un apport n'a pas de pièce de référence.
  @@index([tenantId, sessionId])
  @@index([tenantId, createdAt])
}

// ── BON CADEAU ─────────────────────────────────────────────────────────────────────────────
//
// 🔒 L'INVARIANT, ET IL N'Y EN A QU'UN : LE MONTANT D'UN BON ENTRE DANS LE CA UNE SEULE FOIS,
//    LE JOUR DE SON ACHAT.
//
// Un bon cadeau est une PRESTATION VENDUE À L'AVANCE, pas un moyen de paiement. C'est ce qui
// dicte tout le reste :
//
//  · ACHAT — c'est le jumeau exact d'une vente au comptoir : l'argent est encaissé, le Z le
//    compte, une facture part au nom de l'ACHETEUR. Il passe donc par `checkoutSale` comme
//    n'importe quel ticket, et surtout PAS par un chemin d'encaissement parallèle. Les bons
//    naissent DANS la transaction qui fait passer la vente à PAID : zéro fenêtre entre
//    « l'argent est pris » et « le bon existe ».
//
//  · CONSOMMATION — AUCUNE COMPTABILITÉ. Aucune facture, aucun paiement, aucun mouvement de
//    tiroir, aucun total du Z. Encaisser à nouveau les francs du bon le jour où il est présenté
//    compterait le même argent DEUX FOIS. C'est l'erreur que cette table entière sert à rendre
//    impossible. Le Z ne porte que deux champs INFORMATIFS (compte + montant), volontairement
//    hors de `totalSalesXpf` et de `expectedXpf`.
//
//  · PAS DE NOUVELLE VALEUR D'ENUM. Ni `PayMethod`, ni `LineKind` ne gagnent de valeur : une
//    valeur d'enum PostgreSQL ne se retire JAMAIS. Un complément à payer est une ligne libre
//    `OTHER` ordinaire, réglée par un moyen de paiement ordinaire.
//
// LES DEUX FORMES, UN SEUL MODÈLE. Un bon en VALEUR (« 10 000 F ») et un bon NOMINATIF
// (« un soin du visage ») ne sont pas deux mécaniques : c'est le même objet, avec un champ
// `serviceLabel` optionnel. Un bon nominatif COUVRE la prestation désignée quel que soit le
// tarif du jour — c'est sa raison d'être, la cliente a offert LA PRESTATION, pas une somme.
// `amountXpf` reste renseigné dans les deux cas : c'est ce qui a été encaissé à la vente, donc
// ce qui est déjà entré dans le CA.
//
// BINAIRE, RELIQUAT PERDU. Un bon de 10 000 F utilisé sur une prestation à 6 000 F est brûlé en
// entier. Il n'existe donc aucun solde ici, et il ne faut pas en réintroduire un : `redeemedAt`
// renseigné = consommé, point. `redeemedForXpf` ne calcule rien, il enregistre le prix affiché
// le jour de l'échange, pour recouper après coup.
//
// LE STATUT « EXPIRÉ » N'EST PAS STOCKÉ. Il se DÉRIVE à la lecture de `expiresAt`. Un statut
// stocké imposerait un travail de fond qui fait muter la production toute seule ; on n'en veut
// pas.
model GiftCard {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  // Code recopié à la main d'un bon papier vers un écran, souvent par une autre personne que
  // celle qui l'a écrit. Unique PAR MARCHAND (@@unique ci-dessous) : deux salons peuvent porter
  // le même code sans se voir, c'est le cloisonnement qui l'exige.
  code String

  // Ce qui a été ENCAISSÉ à la vente du bon — donc ce qui est déjà entré dans le CA ce jour-là.
  // TOUJOURS POSITIF, en francs entiers (XPF n'a pas de centime), comme partout dans ce moteur.
  amountXpf BigInt

  // ── La forme NOMINATIVE, optionnelle ──────────────────────────────────────────────────────
  // Renseignée, elle dit que le bon couvre CETTE prestation, quel que soit son tarif au jour de
  // l'échange. Absente, le bon vaut `amountXpf`. Un seul modèle, pas deux mécaniques.
  serviceLabel String? // libellé lisible, celui qui sera lu au comptoir
  serviceId    String? @db.Uuid // référence catalogue quand la surface en a une

  // ── Acheteur : celui qui a payé, et à qui la facture d'achat est adressée ─────────────────
  buyerName  String?
  buyerPhone String?
  buyerEmail String?

  // ── Bénéficiaire : celle qui présentera le bon ────────────────────────────────────────────
  // LES TROIS IDENTIFIANTS SONT STOCKÉS, ET C'EST DÉLIBÉRÉ. Il n'existe AUCUNE table « cliente »
  // dans l'écosystème : une fiche est un regroupement de rendez-vous par clé de dédup, et cette
  // clé CHANGE quand la cliente donne son e-mail après coup. Un bon rattaché à une clé figée
  // décrocherait silencieusement de sa fiche. Le rapprochement se fait donc À LA LECTURE, sur
  // les trois identifiants (cf. lib/gift-card.ts).
  beneficiaryName  String?
  beneficiaryPhone String?
  beneficiaryEmail String?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime? // NULL = sans limite. Le statut « expiré » se dérive, il ne se stocke pas.

  // ── Rattachement à la vente d'achat ───────────────────────────────────────────────────────
  // Scalaires SANS clé étrangère, exactement comme `Sale.sourceId` : le bon ne doit jamais
  // pouvoir bloquer une opération sur la vente, et la trace suffit au rapprochement.
  saleId        String? @db.Uuid
  invoiceNumber String? // facture d'achat, au nom de l'ACHETEUR

  // ── Consommation ──────────────────────────────────────────────────────────────────────────
  // 🔴 `redeemedAt` est LA sentinelle d'unicité : la consommation s'écrit par un UPDATE
  //    conditionné à `redeemedAt IS NULL`, jamais par un SELECT suivi d'un UPDATE. Zéro ligne
  //    affectée ⇒ refus `ALREADY_REDEEMED`. C'est la seule chose qui doit être irréprochable ici.
  redeemedAt     DateTime?
  redeemedBy     String?   @db.Uuid
  redeemedByName String?
  // Prix affiché de la prestation le jour de l'échange. N'ENTRE DANS AUCUN CALCUL de solde (il
  // n'y a pas de solde) : il sert uniquement à recouper la caisse après coup.
  redeemedForXpf BigInt?

  // ── Annulation (ADMIN seule) ──────────────────────────────────────────────────────────────
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?   @db.Uuid
  cancelledByName String?

  // Le code ne vaut QUE dans son marchand. Sans le tenantId, deux salons se voleraient leurs
  // codes — et l'unicité est garantie EN BASE, pas au clic.
  @@unique([tenantId, code])
  // Le Z rattache les consommations par FENÊTRE de temps [openedAt, closedAt] — il n'y a
  // délibérément AUCUNE clé étrangère vers CashSession, parce qu'une consommation n'est pas une
  // opération de caisse. Cet index est ce qui rend ce filtrage tenable.
  @@index([tenantId, redeemedAt])
  @@index([tenantId, issuedAt])
  @@index([tenantId, saleId])
}
